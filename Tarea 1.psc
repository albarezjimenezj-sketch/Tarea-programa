Algoritmo N
	Definir val1,val2 Como Real
	Escribir " Asignar valor 1 y valor 2 " 
	leer val1, val2 
	
	si val1<val2 Entonces
		
		Escribir "la suma es : " , val1+val2 	
	SiNo
		si val1>val2
			Escribir "la resta es :" , val1-val2 
		finsi 
			
		si val1==val2 Entonces
			Escribir"La multiplicacion es : " , val1*val2
		FinSi
		
	FinSi
	
FinAlgoritmo

